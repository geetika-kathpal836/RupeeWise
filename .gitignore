# ==========================================
# RupeeWise Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and Secrets (Never commit credentials or API keys)
.env
.env.*
!.env.example
*.env
*.env.local
backend/.env
backend/.env.*
!backend/.env.example
Frontend/.env
Frontend/.env.*
!Frontend/.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build artifacts & distribution
dist/
dist-ssr/
build/
*/dist/
*/build/
out/

# Logs & Runtime data
logs/
*.log
*.pid
*.seed
*.pid.lock

# Test coverage & debug
coverage/
*.lcov
.nyc_output/
*.swp
*.bak

# Cache directories
.cache/
.vite/
.eslintcache
.oxlintcache
.turbo/
.tempmediaStorage/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

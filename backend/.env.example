PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/RupeeWise?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:5173

# Nodemailer (optional — leave blank to disable email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="RupeeWise <your@gmail.com>"

# Cron job protection secret (used for /api/jobs/run-recurring)
CRON_SECRET=replace_with_random_secret

# Cloudinary (profile picture storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Validation (emailvalidation.io API)
EMAILVALIDATION_API_KEY=your_emailvalidation_api_key_here

